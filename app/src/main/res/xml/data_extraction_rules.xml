<?xml version="1.0" encoding="utf-8"?>
<!-- Trips and locations never go to cloud backup; a direct phone-to-phone transfer may carry them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
