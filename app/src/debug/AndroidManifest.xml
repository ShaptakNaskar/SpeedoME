<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug only: lets this build be picked in Developer options → Select mock location app. -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <application>
        <!-- adb hook: adb shell am broadcast -p <applicationId> -a speedome.MOCK_FIX … (docs/plan.md §11). -->
        <receiver
            android:name=".debug.MockFixReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="speedome.MOCK_FIX" />
                <action android:name="speedome.MOCK_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
